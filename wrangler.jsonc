{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aoe4-analyzer-api",
  "main": "packages/api/src/worker.ts",
  "compatibility_date": "2026-04-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aoe4-analyzer-db",
      "database_id": "91fd2ade-ed51-4367-9991-edc3114fc20d",
      "remote": true,
      "migrations_dir": "packages/core/src/db/migrations"
    }
  ],
  "vars": {
    "FRONTEND_ORIGIN": "https://aoe4-analyzer.pages.dev"
  }
}